{
  "name": "hush",
  "version": "0.2.0",
  "description": "Redact secrets from tool output before the model sees it.",
  "author": { "name": "versa.training", "url": "https://versa.training" },
  "homepage": "https://github.com/versa-training/hush",
  "repository": "https://github.com/versa-training/hush",
  "license": "MIT",
  "keywords": ["secrets", "redaction", "hooks", "security"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/wrap.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/redact.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
