{
  "files": ["~/.config/hush/known-values"],
  "minLength": 12,
  "allow": [],
  "allowLiterals": ["a942b37c"],
  "blockLiterals": true,
  "strictCommands": [
    "\\b(?:docker|podman)(?:\\s+--?[A-Za-z][\\w-]*(?:=[^\\s|;&]*|\\s+(?!-)[^\\s|;&]+)?)*?\\s+(?:container\\s+|image\\s+|network\\s+|volume\\s+)?inspect\\b",
    "\\b(?:docker[\\s-]compose|podman-compose)\\b[^\\n|;&]*\\sconfig\\b",
    "(?:^|[;&|({\\n]|\\bsudo\\s|\\bcommand\\s)\\s*(?:(?:/usr)?/bin/)?(?:env|printenv)\\s*(?=$|[;&|)}\\n>])",
    "\\b(?:docker|podman)\\s+(?:[^\\s|;&]+\\s+){0,12}?(?:exec|run)\\s+(?:[^\\s|;&]+\\s+){1,12}?(?:(?:/usr)?/bin/)?(?:env|printenv)\\s*(?=$|[;&|)}\\n>])",
    "\\bkubectl\\s+(?:[^\\s|;&]+\\s+){0,16}?exec\\s+(?:[^\\s|;&]+\\s+){0,16}?--\\s+(?:(?:/usr)?/bin/)?(?:env|printenv)\\s*(?=$|[;&|)}\\n>])",
    "(?:^|[;&|({\\n]|\\bsudo\\s)\\s*set\\s*(?=$|[;&|)}\\n>])",
    "(?:^|[;&|({\\n]|\\bsudo\\s)\\s*(?:export|declare|typeset)(?:\\s+-[A-Za-z]+)*\\s*(?=$|[;&|)}\\n>])",
    "\\bclever\\s+env\\b",
    "\\bkubectl\\b[^\\n|;&]*\\s(?:get|describe)\\b[^\\n|;&]*\\ssecrets?(?=/|\\s|$|[;&|)])",
    "\\bsystemctl\\b[^\\n|;&]*\\s(?:show\\b[^\\n|;&]*Environment|show-environment\\b)",
    "\\b(?:cat|less|more|head|tail|bat|batcat|grep|egrep|fgrep|rg|sed|awk)\\b[^\\n|;&]*[\\s/'\\\"=]\\.env[\\w.-]*(?<!\\.(?:example|sample|template))(?=$|[\\s'\\\";&|)])",
    "\\bps\\s+(?:[^\\n|;&]*\\s)?[A-Za-z]*e[A-Za-z]*(?=$|[\\s;&|)])",
    "/proc/[^\\s/]+/environ\\b",
    "(?:^|[;&|({\\n]|\\bsudo\\s)\\s*history\\b"
  ],
  "patterns": [
    {"name": "env", "regex": "(?<![A-Za-z0-9_])[A-Za-z0-9_]*(?:KEY|TOKEN|SECRET|PASSWORD|PASSWD|DSN|CREDENTIAL|AUTH|key|token|secret|password|passwd|dsn|credential|auth)[A-Za-z0-9_]*[\"']?\\s*[=:]\\s*[\"']?(?!\\$[A-Za-z_{(])([^\\s\"',;]{12,})"},
    {"name": "jwt", "regex": "eyJ[A-Za-z0-9_-]{5,}\\.eyJ[A-Za-z0-9_-]{5,}\\.[A-Za-z0-9_-]{5,}"},
    {"name": "url-password", "regex": "(?:postgres|postgresql|mysql|redis)://[^\\s:/@]*:(?!\\$[A-Za-z_{(])([^\\s@/]{3,})@"},
    {"name": "dsn", "regex": "https://[0-9a-f]{32}@[^\\s\"']+"},
    {"name": "pem", "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?-----END [A-Z ]*PRIVATE KEY-----"},
    {"name": "github", "regex": "\\b(?:gh[posu]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{22,})"},
    {"name": "anthropic", "regex": "\\bsk-ant-[A-Za-z0-9_-]{20,}"},
    {"name": "openai", "regex": "\\bsk-(?:proj-)?[A-Za-z0-9_-]{32,}"},
    {"name": "aws", "regex": "\\bAKIA[0-9A-Z]{16}\\b"},
    {"name": "google", "regex": "\\bAIza[0-9A-Za-z_-]{35}"},
    {"name": "slack", "regex": "\\bxox[baprs]-[A-Za-z0-9-]{10,}"},
    {"name": "stripe", "regex": "\\b(?:sk|rk)_(?:live|test)_[A-Za-z0-9]{16,}"},
    {"name": "bearer", "regex": "Authorization:\\s*Bearer\\s+([A-Za-z0-9._~+/=-]{12,})"},
    {"name": "redis-cli-a", "regex": "\\bredis-cli\\b[^\\n|;&]{0,300}?\\s(?:-a|--pass)\\s+['\"]?([^\\s'\"$`\\[<-][^\\s'\"]{5,})"},
    {"name": "pass-flag", "regex": "--(?:http-|ftp-|proxy-)?pass(?:word)?(?:=|\\s+)['\"]?([^\\s'\"$`\\[<-][^\\s'\"]{5,})", "skipPlaceholders": true},
    {"name": "requirepass", "regex": "\\b(?:requirepass|masterauth)\\s+['\"]?([^\\s'\"$`\\[<-][^\\s'\"]{5,})", "skipPlaceholders": true},
    {"name": "pgpassword", "regex": "\\bPGPASSWORD=['\\\"]?([^\\s'\\\"$`\\[<][^\\s'\\\"]{5,})"},
    {"name": "mysql-p", "regex": "\\b(?:mysql|mariadb|mysqldump|mysqladmin)\\b[^\\n|;&]{0,300}?\\s-p['\\\"]?([^\\s'\\\"$`\\[<][^\\s'\\\"]{5,})"},
    {"name": "sshpass", "regex": "\\bsshpass\\s+-p\\s*['\\\"]?([^\\s'\\\"$`\\[<][^\\s'\\\"]{5,})"},
    {"name": "curl-user", "regex": "\\bcurl\\b[^\\n|;&]{0,300}?\\s(?:-u\\s*|--user(?:=|\\s+))['\\\"]?[^\\s:'\\\"]+:([^\\s'\\\"$`\\[<][^\\s'\\\"]{5,})"},
    {"name": "basic-auth", "regex": "Authorization:\\s*Basic\\s+([A-Za-z0-9+/=]{8,})"},
    {"name": "url-password-any", "regex": "\\b(?:rediss?|amqps?|mongodb(?:\\+srv)?|https?|ftp|smtps?)://[^\\s:/@]*:([^\\s@/$`\\[<{][^\\s@/]{2,})@", "skipPlaceholders": true},
    {"name": "argv-redis-cli", "regex": "\"redis-cli\"(?:\\s*,\\s*\"[^\"\\n]{0,200}\"){0,8}?\\s*,\\s*\"(?:-a|--pass)\"\\s*,\\s*\"(?![$`\\[<-])((?:[^\"\\\\\\n]|\\\\.){6,})\""},
    {"name": "argv-pass-flag", "regex": "\"--(?:http-|ftp-|proxy-)?pass(?:word)?\"\\s*,\\s*\"(?![$`\\[<-])((?:[^\"\\\\\\n]|\\\\.){6,})\""},
    {"name": "argv-requirepass", "regex": "\"(?:--)?(?:requirepass|masterauth)\"\\s*,\\s*\"(?![$`\\[<-])((?:[^\"\\\\\\n]|\\\\.){6,})\""},
    {"name": "argv-mysql-p", "regex": "\"(?:mysql|mariadb|mysqldump|mysqladmin)\"(?:\\s*,\\s*\"[^\"\\n]{0,200}\"){0,8}?\\s*,\\s*\"-p(?![$`\\[<-])((?:[^\"\\\\\\n]|\\\\.){6,})\""},
    {"name": "argv-sshpass", "regex": "\"sshpass\"\\s*,\\s*\"-p(?:\"\\s*,\\s*\")?(?![$`\\[<-])((?:[^\"\\\\\\n]|\\\\.){6,})\""},
    {"name": "argv-curl-user", "regex": "\"curl\"(?:\\s*,\\s*\"[^\"\\n]{0,200}\"){0,8}?\\s*,\\s*\"(?:-u|--user)\"\\s*,\\s*\"[^\"\\s:]{1,200}:(?![$`\\[<-])((?:[^\"\\\\\\n]|\\\\.){6,})\""}
  ]
}
